---
import type { ImageMetadata } from 'astro';
import albums from '../content/albums.json';
import LazyImage from './LazyImage.astro';

const covers = import.meta.glob<{ default: ImageMetadata }>('../assets/albums/*', { eager: true });

function cover(file: string): ImageMetadata {
    const image = covers[`../assets/albums/${file}`];
    if (!image) {
        throw new Error(`Album cover "${file}" not found in src/assets/albums.`);
    }
    return image.default;
}
---

{[...albums].reverse().map(album => (
    <div class="album">
        <a href={album.link} target="_blank" class="album-cover">
            <LazyImage src={cover(album.cover)} alt={album.name} widths={[320, 480, 640, 960, 1280]} />
        </a>
    </div>
))}
